{
  "name": "@c9up/flare",
  "version": "0.1.0",
  "description": "Flare \u2014 exceptions for the Ream ecosystem: an Exception class carrying a code, an HTTP status and a help text, and createError() to declare an error in one line. No dependency; runs in Node.js, browsers and React Native",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "^6.0.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/flare.git"
  }
}
